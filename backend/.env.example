# Application
APP_NAME=Merix
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (Supabase Postgres + pgvector)
# Format: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.projectref.supabase.co:5432/postgres

# LLM Provider (provider-agnostic)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your-llm-api-key-here
LLM_BASE_URL=

# Embeddings Provider
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Storage (Supabase Storage)
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=resumes
SUPABASE_URL=https://projectref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# Authentication (Supabase Auth / GoTrue)
# JWT Secret: Project Settings -> API -> JWT Secret (used to verify tokens locally)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
JWT_ALGORITHM=HS256

# DPDP Compliance
DATA_RETENTION_DAYS=90
