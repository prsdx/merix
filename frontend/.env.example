# ============================================================
# MERIX FRONTEND ENVIRONMENT CONFIGURATION (Vercel & Local)
# ============================================================
#
# INSTRUCTIONS FOR VERCEL:
# 1. In Vercel Project Dashboard -> Settings -> Environment Variables
# 2. Add NEXT_PUBLIC_API_URL pointing to your deployed backend URL.
#    (e.g., https://merix-backend.onrender.com or https://api.yourdomain.com)
# 3. Add NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY from your Supabase Project Settings.
# ============================================================

# 1. Backend FastAPI URL
# Note: You can provide with or without '/api' suffix (Merix automatically normalizes it)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# 2. Supabase Project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 3. Supabase Public Anon Key (Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
